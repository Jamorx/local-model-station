# Export these variables in your shell; .env is NOT automatically loaded.
MEDIA_LAB_ROOT=~/LocalModelLab
# MEDIA_RUNNER_PYTHON=/absolute/path/to/model/environment/bin/python
# MEDIA_PROFILES_FILE=/absolute/path/to/config/profiles.local.json
# MEDIA_JOBS_DIR=/absolute/path/to/persistent/jobs
# Set a key to require Bearer auth even on LAN.
# MEDIA_API_KEY=replace-me
# MEDIA_HUOBAO_BASE_URL=http://127.0.0.1:3013
# MEDIA_PUBLIC_BASE_URL=http://your-mac.lan:8777
# MEDIA_FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# MEDIA_FFPROBE_BIN=/opt/homebrew/bin/ffprobe
MEDIA_QUEUE_WAIT_TIMEOUT_S=21600
MEDIA_JOB_TIMEOUT_S=3600
