{
  "id": "tonghang-j01-2k-portrait-test",
  "stages": [
    {
      "id": "model-select",
      "type": "model-select",
      "iports": [],
      "config": {
        "hf_dir": "__MODEL_DIR__"
      }
    },
    {
      "id": "load-draft",
      "type": "load-video",
      "iports": [],
      "config": {
        "input_url": "__INPUT_VIDEO__",
        "enable_audio": false
      }
    },
    {
      "id": "draft-frames",
      "type": "video-to-rgb",
      "iports": [
        {
          "src": "load-draft",
          "oport": 0
        }
      ],
      "config": {
        "output_dtype": "u8"
      }
    },
    {
      "id": "draft-24fps",
      "type": "temporal-resample",
      "iports": [
        {
          "src": "draft-frames",
          "oport": 0
        }
      ],
      "config": {
        "output_fps": 24,
        "method": "nearest"
      }
    },
    {
      "id": "draft-head",
      "type": "temporal-slice",
      "iports": [
        {
          "src": "draft-24fps",
          "oport": 0
        }
      ],
      "config": {
        "start": 0,
        "end": 22
      }
    },
    {
      "id": "draft-fit",
      "type": "image-resample",
      "iports": [
        {
          "src": "draft-head",
          "oport": 0
        }
      ],
      "config": {
        "width": 1024,
        "height": 1792,
        "fit": "crop",
        "algorithm": "bilinear"
      }
    },
    {
      "id": "draft-clip",
      "type": "temporal-stack",
      "iports": [
        {
          "src": "draft-fit",
          "oport": 0
        }
      ],
      "config": {
        "mode": "video",
        "group_size": 0,
        "max_mb": 4096
      }
    },
    {
      "id": "vae-encode",
      "type": "vae-encode",
      "iports": [
        {
          "src": "draft-clip",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {
        "posterior": "sample",
        "posterior_seed": 42,
        "unload_when_idle": "destroy"
      }
    },
    {
      "id": "latent-upscale",
      "type": "latent-upscale",
      "iports": [
        {
          "src": "vae-encode",
          "oport": 0
        }
      ],
      "config": {
        "hf_dir": "__UPSAMPLER_DIR__",
        "width": 1440,
        "height": 2560,
        "frames": 22
      }
    },
    {
      "id": "text-prompt",
      "type": "text-prompt",
      "iports": [],
      "config": {
        "text": "Fixed extreme close-up at a wooden counter. A blue-gray plush bear with a red scarf holds a large brown bamboo shoot with a small white barcode label near its base, paws rotating it slightly. Paws and shoot stay unchanged."
      }
    },
    {
      "id": "diffusion-conditioner",
      "type": "diffusion-conditioner",
      "iports": [
        {
          "src": "text-prompt",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {
        "unload_when_idle": "always"
      }
    },
    {
      "id": "minimax-h3-model-config",
      "type": "minimax-h3-model-config",
      "iports": [],
      "config": {
        "lora": "__LORA_PATH__",
        "lora_scale": 1.0
      }
    },
    {
      "id": "generate-video",
      "type": "generate-video",
      "iports": [
        {
          "src": "diffusion-conditioner",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "minimax-h3-model-config",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "latent-upscale",
          "oport": 0
        }
      ],
      "config": {
        "height": 2560,
        "width": 1440,
        "frames": 22,
        "fps": 24,
        "steps": 3,
        "seed": 42,
        "unload_when_idle": "always",
        "i8_gemm": true,
        "i8_gemm_tier": "token"
      }
    },
    {
      "id": "vae-decode",
      "type": "vae-decode",
      "iports": [
        {
          "src": "generate-video",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "rgb-to-video",
      "type": "rgb-to-video",
      "iports": [
        {
          "src": "vae-decode",
          "oport": 0
        }
      ],
      "config": {
        "fps": 24
      }
    },
    {
      "id": "load-audio",
      "type": "load-audio",
      "iports": [],
      "config": {
        "input_url": "__INPUT_AUDIO__",
        "duration_s": 0.9166666666666666
      }
    },
    {
      "id": "audio-to-pcm",
      "type": "audio-to-pcm",
      "iports": [
        {
          "src": "load-audio",
          "oport": 0
        }
      ],
      "config": {
        "output_sample_rate": 48000,
        "channels": 2,
        "chunk_duration_s": 10.0,
        "max_chunk_duration_s": 30.0
      }
    },
    {
      "id": "save-video",
      "type": "save-video",
      "iports": [
        {
          "src": "rgb-to-video",
          "oport": 0
        },
        {
          "src": "audio-to-pcm",
          "oport": 0
        }
      ],
      "config": {
        "output_url": "__OUTPUT_VIDEO__",
        "enable_video": true,
        "enable_audio": true,
        "video_bitrate": 24000000,
        "video_gop_size": 48,
        "audio_bitrate": 192000,
        "muxer_options": {
          "movflags": "+faststart"
        }
      }
    }
  ],
  "subpipelines": []
}
