{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "path": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "video",
            "audio"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "title": "Artifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "gateway.result.v1",
      "default": "gateway.result.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "metrics": {
      "additionalProperties": true,
      "title": "Metrics",
      "type": "object"
    },
    "details": {
      "additionalProperties": true,
      "title": "Details",
      "type": "object"
    }
  },
  "required": [
    "artifacts"
  ],
  "title": "EngineResult",
  "type": "object"
}
