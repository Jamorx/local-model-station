{
  "$defs": {
    "ResolvedInputs": {
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "assets": {
          "items": {
            "$ref": "#/$defs/StoredAsset"
          },
          "title": "Assets",
          "type": "array"
        }
      },
      "required": [
        "prompt",
        "assets"
      ],
      "title": "ResolvedInputs",
      "type": "object"
    },
    "Selection": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "engine_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine Id"
        },
        "registry_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registry Revision"
        }
      },
      "title": "Selection",
      "type": "object"
    },
    "StoredAsset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "audio",
            "video"
          ],
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "probe": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probe"
        },
        "probe_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probe Status"
        }
      },
      "required": [
        "id",
        "role",
        "path",
        "kind",
        "media_type",
        "bytes",
        "sha256",
        "url"
      ],
      "title": "StoredAsset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "gateway.task.v1",
      "default": "gateway.task.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "profile": {
      "title": "Profile",
      "type": "string"
    },
    "kind": {
      "enum": [
        "image",
        "video",
        "audio"
      ],
      "title": "Kind",
      "type": "string"
    },
    "selection": {
      "$ref": "#/$defs/Selection"
    },
    "inputs": {
      "$ref": "#/$defs/ResolvedInputs"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "options": {
      "additionalProperties": true,
      "title": "Options",
      "type": "object"
    },
    "metadata": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Metadata",
      "type": "object"
    },
    "derived_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Derived From"
    }
  },
  "required": [
    "id",
    "profile",
    "kind",
    "selection",
    "inputs",
    "parameters",
    "options",
    "metadata"
  ],
  "title": "TaskDocument",
  "type": "object"
}
